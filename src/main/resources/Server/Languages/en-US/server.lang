commands.worm.disturb.desc = The sand disturbance, which the worm answers building with: disturb [here] | status | stop [here|all] | fallback on|off
commands.worm.disturb.started = Sand disturbance started in chunk {chunk} with an empty list: the rumble and the end run, nothing is removed.
commands.worm.disturb.busy = A disturbance is already running in this chunk.
commands.worm.disturb.noDunes = Dunes of Arrakis is not installed, so there is no Arrakis_Sand and nothing happens.
commands.worm.disturb.none = No sand disturbances running.
commands.worm.disturb.line = {line}
commands.worm.disturb.forced = Forced lag fallback: {state}
commands.worm.disturb.stopped = Stopped {count} disturbance(s): sand restored, nothing removed, nobody killed.
commands.worm.disturb.usage = Usage: /worm disturb [here] | status | stop [here|all] | fallback on|off
commands.worm.status.tracking = Tracking {mobs} hostile mobs ({hostile} hostile near a player, {scanned} NPCs in the world; last tick {ms} ms, worst {max} ms) and {totems} totems ({landed} landed since start).
commands.worm.aggro.beings = {count} {kind} tracked in this world:
commands.worm.aggro.being =   {name}: aggro {score}, {distance} blocks away, {sand}, {event}
commands.worm.nearest.none = No free {kind} is tracked in this world.
commands.worm.totem.desc = The totem registry for this session: totem add|remove|list [deployableId]
commands.worm.totem.usage = Usage: /worm totem add|remove|list <deployableId>
commands.worm.totem.added = {id} now counts as a totem.
commands.worm.totem.already = {id} already counts as a totem.
commands.worm.totem.removed = {id} no longer counts as a totem.
commands.worm.totem.unknown = {id} was not a registered totem.
commands.worm.totem.list = Totems: {ids}
commands.wormtest.entitytest.desc = Headless: spawn NPCs and a totem and report what the game does with them (stumble, hold, sink, kill, drops, cost, a whole totem event)
