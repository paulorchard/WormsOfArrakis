commands.wormtest.desc = Throwaway engine tests for the sandworm mod (operators only)
commands.wormtest.ripple.desc = The ground gives way then springs back, shown only to clients: ripple [increment 1-4] [self|nearby] [rings] [seed] [shake=on|off] [step] [swing]; ripple debug [increment] [rings] [seed]
commands.wormtest.vignette.desc = A screen overlay: vignette on|off [weather-soft|weather-sand|effect-soft|effect-sand]
commands.wormtest.slow.desc = Ramp your speed down then restore: slow <percent|off> [seconds] [base|mult|jump|air|accel|all|effect] [updatesPerSecond]
commands.wormtest.worm.desc = A moving stand-in worm: worm [scale|remove|lift <blocks>] [persist]
commands.wormtest.burst.desc = A dust plume 10 blocks ahead: burst [scale] [variant 1-5]
commands.wormtest.rumble.desc = Low rumble sounds: rumble [seconds] [statue|ice|storm|layered|ambience|stop] [pitch]
commands.wormtest.speed.desc = Measure your real walk, run and sprint speed: speed [seconds]
commands.wormtest.selftest.desc = Check assets and run the ripple and worm code (around you if run by a player, else around the origin)
