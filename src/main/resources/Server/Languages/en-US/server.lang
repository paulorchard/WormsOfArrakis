items.Arrakis_Worm_Ripple_Layer_4.name = Ripple layer 4 px (test)
wormsOfArrakis.event.start = [Worm #{id}] started for group [{group}], target {target}, stalking for {seconds}s
wormsOfArrakis.event.phase = [Worm #{id}] {old} -> {new}, target {target}, {seconds}s
wormsOfArrakis.event.retarget = [Worm #{id}] retarget {old} -> {new}
wormsOfArrakis.event.end = [Worm #{id}] ended: {reason}
commands.worm.desc = Sandworm aggro and events (operators only)
commands.worm.status.desc = Active worm events, cooldowns, and your aggro and group total
commands.worm.aggro.desc = A player's aggro and what feeds it: aggro [player]
commands.worm.add.desc = Add aggro to a player: add <player> <amount>
commands.worm.trigger.desc = Start a worm event now, ignoring threshold and cooldown: trigger [player|self] [stalkSeconds] [lockSeconds]
commands.worm.stop.desc = End a player's worm event, or all events: stop [player]
commands.worm.ignore.desc = Toggle a player being ignored by the worms: ignore <player>
commands.worm.needPlayer = Name a player; the console has no position.
commands.worm.noPlayer = No such player: {name}
commands.worm.status.none = No worm events.
commands.worm.status.event = #{id} {phase}, {seconds}s left, target {target}, group [{group}], world {world}, worm at {worm}
commands.worm.aggro.line = {player}{ignored}: aggro {score}, group {group}, on sand {onSand}, speed {speed} blocks/s
commands.worm.aggro.feeding = Feeding it: {sources}
commands.worm.add.usage = Usage: /worm add <player> <amount>
commands.worm.add.done = Added {amount} to {player}: now {score}
commands.worm.ignore.usage = Usage: /worm ignore <player>
commands.worm.ignore.on = {player} is now ignored by the worms.
commands.worm.ignore.off = {player} is no longer ignored.
commands.worm.trigger.done = Worm event #{id} started on {target}: stalk {stalk}s, lock {lock}s. Threshold and cooldown skipped.
commands.worm.trigger.busy = {player} is already in a worm event ({phase}). /worm stop first.
commands.worm.trigger.ineligible = {player} cannot be a target: creative, dead, ignored or not in a world.
commands.worm.stop.done = Stopped {count} event(s).
commands.worm.preview.desc = One worm effect on you alone, ramping up, to tune it: preview <wormsign|rumble|ripple|vignette|slow|shake|zoom|off> [seconds]
commands.worm.preview.usage = Usage: /worm preview <{effects}|off> [seconds]
commands.worm.preview.start = Previewing {effect} for {seconds}s, ramping from nothing to full.
commands.worm.preview.off = Preview stopped.
wormsOfArrakis.death = {player} was devoured by a sandworm
commands.worm.breach.desc = Skip to the breach: breach [player|self] swallows that player, breach here plays it at your spot with no victim
commands.worm.breach.here = Breach played at your position, no victim.
